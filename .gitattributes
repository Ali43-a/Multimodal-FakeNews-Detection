*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.ipynb -text
*.csv -text
*.json -text
*.parquet -text
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary

